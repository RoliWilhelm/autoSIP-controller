# autoSIP-specific runtime data. Per-run logs are written to
# <repo>/logs/<project>/<timestamp>_<sample>/ -- visible in a file manager
# but not committed (one folder per run). Per-user config + saved profiles
# live under ~/.autosip/, not in the repo, so they don't need to be ignored
# here. The repo's profiles/ directory ships starter JSON files and IS
# tracked.
logs/

# Stray-output guards (harmless if absent).
runs/
config.json

# Notification config holds the ntfy topic — anyone who knows the topic can
# read the operator's push stream, so the file must not be committed even
# if a stray copy ever lands in the repo. Per-user file lives under
# ~/.autosip/notification_config.json.
notification_config.json
